configuration {
    modi: "drun,filebrowser,calc";
    show-icons: true;
    icon-theme: "HighContrast";
    drun-display-format: "{name}";

    display-drun: "Apps";
    display-filebrowser: "Files";
    display-calc: "Calc";

    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

@theme "~/.config/rofi/launcher.rasi"
