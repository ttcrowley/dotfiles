#!/usr/bin/env python3
"""theme-apply [dark|light]

This goes on .local/bin/

Applies the Quickshell theme mode to kitty, Yazi, GTK3, GTK4, Obsidian and Zen, then runs the
extra hook scripts (the wallpaper switcher).

Palettes come from ~/.config/quickshell/Theme.qml (the `dark ? "#..." : "#..."` lines),
so Theme.qml stays the single source of truth. The dark files in ~/.config/theme/ are
templates: for dark they are copied as they are; for light every palette color in them
is swapped for its light counterpart. Any other color (the pastel file-type colors in
Yazi, for example) is darkened automatically until it reads well on the light background.

With no argument it applies whatever mode is saved in ~/.local/state/quickshell-theme.
"""
import colorsys
import os
import re
import signal
import subprocess
import sys
import tempfile
from pathlib import Path

HOME = Path.home()
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state")
STATE_FILE = STATE_DIR / "quickshell-theme"
THEME_QML = HOME / ".config/quickshell/Theme.qml"
TEMPLATES = HOME / ".config/theme"
# Path to your Zen Browser profile directory (find it via about:support)
ZEN_PROFILE_DIR = HOME / ".config/zen/9ebqmilv.Default (release)"

# (dark template, generated file). Edit paths here if yours differ.
TARGETS = [
    (TEMPLATES / "kitty.dark.conf", HOME / ".config/kitty/theme.conf"),
    (TEMPLATES / "yazi.dark.toml", HOME / ".config/yazi/theme.toml"),
    (TEMPLATES / "gtk3.dark.css", HOME / ".config/gtk-3.0/gtk.css"),
    (TEMPLATES / "gtk4.dark.css", HOME / ".config/gtk-4.0/gtk.css"),
    # Obsidian (Minimal theme): a CSS snippet. Enable "theme-sync" once under
    # Settings > Appearance > CSS snippets.
    (TEMPLATES / "obsidian.dark.css", HOME / "Documentos/notas2026/.obsidian/snippets/theme-sync.css"),
    # Zen Browser colors
    (TEMPLATES / "zen.dark.css", ZEN_PROFILE_DIR / "chrome" / "userChrome.css"),
    (TEMPLATES / "zen.dark.content.css", ZEN_PROFILE_DIR / "chrome" / "userContent.css"),
    (TEMPLATES / "nvim.dark.lua", HOME / ".config/nvim/colors/qs.lua"),
]

# Scripts called as `<script> dark|light` after the files are written.
HOOKS = [
    HOME / ".config/hypr/scripts/switch-wallpaper.sh",
]

HEX = r"#[0-9A-Fa-f]{6}\b"
PALETTE_LINE = re.compile(
    r'property\s+color\s+(\w+)\s*:\s*dark\s*\?\s*"(%s)"\s*:\s*"(%s)"' % (HEX, HEX)
)


def read_palettes():
    """role -> (dark, light), read from Theme.qml."""
    if not THEME_QML.exists():
        sys.exit(f"theme-apply: {THEME_QML} not found")
    roles = {}
    for role, dark, light in PALETTE_LINE.findall(THEME_QML.read_text()):
        roles[role] = (dark.upper(), light.upper())
    if "bg" not in roles:
        sys.exit("theme-apply: could not read the palette from Theme.qml")
    return roles


def luminance(h):
    c = [int(h[i:i + 2], 16) / 255 for i in (1, 3, 5)]
    c = [v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4 for v in c]
    return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]


def contrast(a, b):
    la, lb = sorted((luminance(a), luminance(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)


def derive_light(color, light_bg, target=4.6):
    """Keep hue and saturation, lower lightness until it reads on the light bg."""
    r, g, b = (int(color[i:i + 2], 16) / 255 for i in (1, 3, 5))
    h, l, s = colorsys.rgb_to_hls(r, g, b)
    while l > 0.05:
        rr, gg, bb = colorsys.hls_to_rgb(h, l, s)
        out = "#%02X%02X%02X" % (round(rr * 255), round(gg * 255), round(bb * 255))
        if contrast(out, light_bg) >= target:
            return out
        l -= 0.01
    return "#000000"


def to_light(text, roles):
    mapping = {dark: light for dark, light in roles.values()}
    light_bg = roles["bg"][1]

    def sub(m):
        c = m.group(0).upper()
        if c not in mapping:
            mapping[c] = derive_light(c, light_bg)
        return mapping[c]

    text = re.sub(HEX, sub, text)
    # CSS keywords the hex swap can't reach:
    text = re.sub(r"color-scheme\s*:\s*[^;]*dark[^;]*", "color-scheme: light", text)
    return text
    text = re.sub(r'background\s*=\s*"dark"', 'background = "light"', text)

def both_modes(text, roles):
    """Zen's userChrome loads only at startup, so ship both palettes and let
    prefers-color-scheme (driven by gsettings) pick one live."""
    return (
        "@media (prefers-color-scheme: dark) {\n" + text + "\n}\n\n"
        "@media (prefers-color-scheme: light) {\n" + to_light(text, roles) + "\n}\n"
    )


def banner(path, template):
    note = f"generated by theme-apply from {template.name}: edit the template, not this file"
    if path.suffix == ".css":
        return f"/* {note} */\n"
    if path.suffix == ".lua":
        return f"-- {note}\n"
    return f"# {note}\n"

def write(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=".theme-apply-")
    with os.fdopen(fd, "w") as f:
        f.write(content)
    os.chmod(tmp, 0o644)
    # os.replace swaps the path itself, so a symlink (e.g. from Stow) is replaced
    # by a regular file and the file it pointed at is left untouched.
    os.replace(tmp, path)


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else None
    if mode is None:
        saved = STATE_FILE.read_text().strip() if STATE_FILE.exists() else "dark"
        mode = "light" if saved == "light" else "dark"
    if mode not in ("dark", "light"):
        sys.exit("usage: theme-apply [dark|light]")

    roles = read_palettes()
    for template, dest in TARGETS:
        if not template.exists():
            print(f"theme-apply: skipping {dest.name}, missing template {template}", file=sys.stderr)
            continue
        text = template.read_text()
        if template.name == "zen.dark.css":
            text = both_modes(text, roles)
        elif mode == "light":
            text = to_light(text, roles)
        write(dest, banner(dest, template) + text)

    for hook in HOOKS:
        if hook.exists():
            subprocess.run(["bash", str(hook), mode], check=False)

    # kitty re-reads its config (and the included theme.conf) on SIGUSR1
    subprocess.run(["pkill", "-USR1", "-x", "kitty"], check=False)
    # Yazi and GTK3 read their files at startup: windows that are already open keep
    # the old colors until they are reopened.
    
    # nvim reloads its colorscheme on SIGUSR1 (see the autocmd in init.lua)
    subprocess.run(["pkill", "-USR1", "-x", "nvim"], check=False)
    
    # Zen's websites (and, via prefers-color-scheme, its UI) follow the system scheme live
    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "color-scheme",
                    "prefer-dark" if mode == "dark" else "prefer-light"], check=False)


if __name__ == "__main__":
    main()
